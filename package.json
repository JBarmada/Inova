{
  "name": "inova",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "preview:tailscale": "node scripts/tailscale-preview.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir src",
    "test:preview": "node --test scripts/preview-ai-handler.test.mjs",
    "check:size": "node scripts/check-size.mjs",
    "check": "npm run check:size && npm run check:clips && npm run check:walk && npm run typecheck && npm test && npm run test:preview && npm run build",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "check:clips": "node scripts/check-clip-assets.mjs",
    "check:walk": "node scripts/verify-walk-atlas.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-store": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
